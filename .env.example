# Copy this file to .env for local development (`cp .env.example .env`).
# main.go loads .env automatically on startup via godotenv.
#
# Connection string for the Postgres started by docker-compose. The DB is
# published on host port 5433 (DB_PORT), so use localhost:5433 from the host.
DATABASE_URL=postgres://expense:expense@localhost:5433/expenses?sslmode=disable
